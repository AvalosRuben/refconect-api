PORT=3000
# Puerto del host para PostgreSQL (cámbialo si 5432 ya está ocupado y ajusta DATABASE_URL).
DB_PUERTO=5432
DATABASE_URL=postgres://refconect:refconect@localhost:5432/refconect
# Cambia este valor: cadena larga y aleatoria (ej. `openssl rand -hex 32`).
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRA_SEGUNDOS=28800
